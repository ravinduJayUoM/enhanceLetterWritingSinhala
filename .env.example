# Copy to .env and fill in real values. Do NOT commit .env.
# .env is loaded by docker-compose and passed to the container.

# Required: Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Required: secret used to sign JWT access tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Optional: override the SQLite users DB path. The compose file already sets
# this to a named volume; override here only if running the image differently.
# USERS_DB_PATH=/app/rag/db/users.db

# Optional: Azure OpenAI (only needed if you switch the provider in config.py)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=
